---
// src/components/content/WorksBrowser.astro
import Icon from "../ui/Icon.astro";
import type { WorksNode } from "../../utils/works";

interface Props {
    items: WorksNode[];
    basePath: string;
}

const props = Astro.props;
const items = props.items;
const basePath = props.basePath;

function fileHref(filePath: string): string {
    const base = import.meta.env.BASE_URL;
    let normalizedBase = base;
    if (normalizedBase.endsWith("/")) {
        normalizedBase = normalizedBase.slice(0, -1);
    }
    return normalizedBase + "/works/" + filePath;
}

function folderHref(folderPath: string): string {
    return "/publications/works/" + folderPath;
}

function displayTitle(node: WorksNode): string {
    if (node.meta && node.meta.title) {
        return node.meta.title;
    }
    return node.name;
}

const folders = items.filter(function (i) {
    return i.type === "folder";
});

const files = items.filter(function (i) {
    return i.type === "file";
});
---

{folders.length > 0 && (
    <div class="folder-grid">
        {folders.map((folder) => (
            <a href={folderHref(folder.path)} class="folder-item">
                <Icon name="Folder" size={32} />
                <span class="folder-item-name">{folder.name}</span>
            </a>
        ))}
    </div>
)}

{files.length > 0 && (
    <div class="works-accordion mt-8">
        {files.map((file) => (
            <details class="works-entry">
                <summary class="works-entry-summary">
                    <span class="works-entry-title">{displayTitle(file)}</span>
                    <span class="works-entry-meta">
                        {file.meta && file.meta.status && (
                            <span class="works-entry-status">{file.meta.status}</span>
                        )}
                        <span class="works-entry-chevron">▶</span>
                    </span>
                </summary>
                <div class="works-entry-body">
                    {file.meta && file.meta.abstract && (
                        <p class="works-entry-abstract">{file.meta.abstract}</p>
                    )}
                    <a
                        href={fileHref(file.path)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="works-entry-download"
                    >
                        <Icon name="FileText" size={16} />
                        View {file.name}
                    </a>
                </div>
            </details>
        ))}
    </div>
)}

{folders.length === 0 && files.length === 0 && (
    <p class="body opacity-60 italic mt-8 text-center">This folder is empty.</p>
)}
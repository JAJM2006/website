---
// src/components/content/WorksBrowser.astro
import Icon from "../ui/Icon.astro";
import type { WorksNode } from "../../utils/works";

interface Props {
    items: WorksNode[];
    basePath: string;
}

const props = Astro.props;
const items = props.items;
const basePath = props.basePath;

const fileIconMap: Record<string, string> = {
    pdf: "FileText",
    md: "FileText",
    doc: "FileText",
    docx: "FileText",
};

function getFileIcon(ext: string | undefined): string {
    if (!ext) {
        return "FileText";
    }
    if (fileIconMap[ext]) {
        return fileIconMap[ext];
    }
    return "FileText";
}

function fileHref(filePath: string): string {
    const base = import.meta.env.BASE_URL;
    let normalizedBase = base;
    if (normalizedBase.endsWith("/")) {
        normalizedBase = normalizedBase.slice(0, -1);
    }
    return normalizedBase + "/works/" + filePath;
}

function folderHref(folderPath: string): string {
    return basePath + "/" + folderPath;
}

const folders = items.filter(function (i) {
    return i.type === "folder";
});

const files = items.filter(function (i) {
    return i.type === "file";
});
---

{folders.length > 0 && (
    <div class="folder-grid">
        {folders.map((folder) => (
            <a href={folderHref(folder.path)} class="folder-item">
                <Icon name="Folder" size={32} />
                <span class="folder-item-name">{folder.name}</span>
            </a>
        ))}
    </div>
)}

{files.length > 0 && (
    <div class="file-list mt-8">
        {files.map((file) => (
            
                href={fileHref(file.path)}
                target="_blank"
                rel="noopener noreferrer"
                class="file-item"
            <a>
                <Icon name={getFileIcon(file.ext)} size={20} />
                <span class="file-item-name">{file.name}</span>
                <span class="file-item-ext">.{file.ext}</span>
            </a>
        ))}
    </div>
)}

{folders.length === 0 && files.length === 0 && (
    <p class="body opacity-60 italic mt-8 text-center">This folder is empty.</p>
)}
---
import { getCollection } from "astro:content";
import BaseDetail from "../../layouts/BaseDetail.astro";
import { PAGES } from "../../config";

if (PAGES.suggestions.isActive === false) {
    return Astro.redirect("/404");
}

export async function getStaticPaths() {
    if (PAGES.suggestions.isActive === false) return [];
    const suggestions = await getCollection("suggestions");
    return suggestions.map((talk: any) => ({
        params: { id: talk.id },
        props: { talk },
    }));
}

const { id } = Astro.params;
---

<BaseDetail collection="suggestions" id={id} />
